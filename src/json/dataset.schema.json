{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dataset.schema.json",
  "$defs": {
    "fontWeight": {
      "title": "Font Weight",
      "type": "integer",
      "minimum": 100,
      "maximum": 900,
      "default": 500,
      "x-format": "range",
      "x-inputAttributes": {
        "step": "25"
      }
    },
    "fontParams": {
      "title": "Font Params",
      "x-interface": "Font Params",
      "type": "object",
      "x-format": "grid",
      "x-startCollapsed": true,
      "x-enableCollapseToggle": true,
      "properties": {
        "weight": {"$ref": "#/$defs/fontWeight"},
        "scale": {
          "type": "number",
          "description": "Scale the font-size by this factor.",
          "default": 1,
          "minimum": 0
        },
        "shift": {
          "type": "number",
          "default": 0,
          "description": "Font up/down shift in em units. Negative: up, positive: down."
        },
        "styleset": {
          "type": "string",
          "description": "CSS property font-variant-alternates: styleset(...)."
        },
        "letterSpacing": {
          "type": "string",
          "description": "CSS letter-spacing property."
        },
        "lineHeight": {
          "type": "number",
          "description": "CSS line-height property."
        }
      },
      "additionalProperties": false
    },
    "fontRef": {
      "type": "object",
      "title": "Font Reference",
      "x-interface": "Font Reference",
      "properties": {
        "key": {
          "type": "string",
          "title": "Key",
          "description": "One of the keys set in the letterConfig.fonts object."
        },
        "params": {"$ref": "#/$defs/fontParams"}
      },
      "additionalProperties": false
    },
    "selectorBlock": {
      "title": "Selector Block",
      "x-interface": "Selector Block",
      "type": "object",
      "oneOf": [
        {
          "x-interface": "Selector Grid Block",
          "properties": {
            "style": {"$ref": "#/$defs/blockStyle"},
            "grid": {"const": true},
            "dimensions": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minLength": 2,
              "maxLength": 2,
              "tsType": "[number, number]"
            },
            "columnLabels": {"$ref": "#/$defs/blockLabels"},
            "rowLabels": {"$ref": "#/$defs/blockLabels"},
            "columnLabelPosition": {
              "enum": ["start", "end", "both"],
              "x-enumTitles": ["Start", "End", "Start & End"],
              "default": "start"
            },
            "rowLabelPosition": {
              "enum": ["start", "end", "both"],
              "x-enumTitles": ["Start", "End", "Start & End"],
              "default": "start"
            },
            "columnLabelSpans": {
              "type": "array",
              "items": {"type": "number"}
            },
            "rowLabelSpans": {
              "type": "array",
              "items": {"type": "number"}
            },
            "rangeMode": {
              "title": "Grid Range Mode",
              "x-interface": "Grid Range Mode",
              "enum": ["grid", "walkRows", "walkColumns"],
              "x-enumTitles": ["Grid", "Walk Rows", "Walk Columns"],
              "default": "grid",
              "description": "How elements are selected using range selection."
            },
            "fillDirection": {
              "enum": ["rows", "columns"],
              "x-enumTitles": ["Rows", "Columns"],
              "default": "rows",
              "description": "How to fill the grid with items from the array."
            },
            "gaps": {"$ref": "#/$defs/matrixRanges"}
          },
          "required": ["grid", "dimensions"]
        },
        {
          "properties": {
            "style": {"$ref": "#/$defs/blockStyle"},
            "grid": {"const": false}
          }
        }
      ]
    },
    "matrixRanges": {
      "type": "string",
      "pattern": "^(\\((\\d+(:\\d+){0,2},)*(\\d+(:\\d+){0,2},?)\\|(\\d+(:\\d+){0,2},)*(\\d+(:\\d+){0,2},?)\\)(;|$))+$",
      "description": "Comma-separated list of 'rectangle' ranges (ROWS|COLUMNS), where ROWS and COLUMNS are in range-syntax."
    },
    "blockLabels": {
      "type": "array",
      "items": {
        "type": ["string", "null"]
      },
      "description": "If string, split up into characters as labels. Use null for a gap instead of a label."
    },
    "blockStyle": {
      "title": "Selector Block Style",
      "x-interface": "Selector Block Style",
      "type": "object",
      "x-format": "grid",
      "properties": {
        "buttonWidth": {
          "type": "string",
          "description": "Equivalent to setting buttonMinWidth and buttonMaxWidth to the same value."
        },
        "buttonMinWidth": {
          "type": "string",
          "default": "0"
        },
        "buttonMaxWidth": {
          "type": "string",
          "default": "1fr"
        },
        "symbolSize": {
          "type": "number",
          "default": 1
        },
        "symbolMinWidth": {
          "type": "string",
          "default": "auto"
        },
        "labelGap": {
          "type": "number",
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "quizAnswerConfig": {
      "x-interface": "Quiz Answer Config",
      "title": "Answer Config",
      "oneOf": [
        {
          "type": "object",
          "x-switcherTitle": "String",
          "properties": {
            "type": {
              "const": "string"
            },
            "properties": {
              "type": "object",
              "x-interface": "String Answer Config",
              "title": "Config",
              "properties": {
                "maxDist": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0,
                  "description": "Maximum distance (optimal string alignment) to pass."
                },
                "maxDistMult": {
                  "type": "number",
                  "description": "If value is n, add 1 to maxDist for every n characters of the word.",
                  "minimum": 0,
                  "default": 0
                },
                "substitutions": {
                  "type": "array",
                  "description": "Search-replace entries, using regular expressions, to describe equivalent substitutions that the answerer can use.",
                  "x-format": "table-object",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pattern": {
                        "type": "string"
                      },
                      "repl": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": ["pattern", "repl"]
                  }
                },
                "forceSubstitutions": {
                  "title": "Force substitutions",
                  "type": "boolean",
                  "default": false,
                  "description": "If true, the substitutions need to be used if applicable."
                },
                "caseSensitive": {
                  "title": "Case-sensitive",
                  "type": "boolean",
                  "default": false,
                  "description": "Whether the answer is case-sensitive."
                },
                "ignoreBrackets": {
                  "title": "Ignored brackets contents",
                  "type": "string",
                  "default": "(",
                  "description": "Used to ignore content in brackets or parentheses for grading. String of opening bracket characters, e.g. \"([\" to ignore (...) and [...]."
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "x-switcherTitle": "Numeric",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["number", "integer"],
              "x-enumTitles": ["Number", "Integer"]
            },
            "properties": {
              "type": "object",
              "title": "Number Answer Config",
              "properties": {
                "maxDist": {
                  "type": "number",
                  "default": 0,
                  "description": "Maximum distance from value to pass."
                },
                "distanceMode": {
                  "type": "string",
                  "default": "linear",
                  "description": "\"linear\" (default), \"log\" or \"log{BASE}\" where BASE is the log base to use, default base is 10."
                }
              }
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "x-interface": "List Answer Config",
          "title": "List Answer Config",
          "x-switcherTitle": "List",
          "properties": {
            "type": {
              "const": "list"
            },
            "properties": {
              "type": "object",
              "x-format": "grid",
              "properties": {
                "splitter": {
                  "type": "string",
                  "default": "[,/]",
                  "description": "RegExp to split input into list of answers."
                },
                "gradeMode": {
                  "enum": ["one", "all"],
                  "x-enumTitles": ["Match One", "Match All"],
                  "default": "one",
                  "description": "Whether one or all of the entries need to be matched. One will use the best score of the entries, All will use the average."
                }
              }
            },
            "items": {
              "title": "Items",
              "$ref": "#/$defs/quizAnswerConfig"
            }
          },
          "required": ["type", "items"],
          "additionalProperties": false
        }
      ]
    },
    "letterRange": {
      "type": "string",
      "pattern": "([^:,]+(:[^:,]+)?)(, ?([^:,]+(:[^:,]+)?))*",
      "description": "Inclusive ranges denoted by `start:stop`, separated by commas."
    },
    "letterRanges": {
      "title": "Letter Ranges",
      "x-interface": "Letter Ranges",
      "type": "object",
      "properties": {
        "i0": {
          "$ref": "#/$defs/letterRange",
          "description": "0-based index ranges."
        },
        "i1": {
          "$ref": "#/$defs/letterRange",
          "description": "1-based index ranges."
        }
      },
      "patternProperties": {
        "^(form(:[a-z]+)?|prop:[a-z]+(>(v|var|variant):[a-z]+)?(>(l|lang|language):[a-z]+)?)$": {
          "$ref": "#/$defs/letterRange"
        }
      },
      "unevaluatedProperties": false
    },
    "letterKey": {
      "type": "string",
      "default": "i1",
      "description": "Default key to be used in the letters field of data entries.",
      "pattern": "^(i0|i1|form(:[a-z]+)?|prop:[a-z]+(>(v|var|variant):[a-z]+)?(>(l|lang|language):[a-z]+)?)$"
    },
    "component": {
      "type": "object",
      "title": "Component",
      "description": "Reference component from a file in the components directory, that will be substituted in.",
      "properties": {
        "$component": {
          "type": "string",
          "title": "Path To Component",
          "pattern": "\\w+(/\\w+)*",
          "description": "Path from components directory, if reached a file (without the extension .json), will treat the rest of the path as keys in the json file."
        }
      },
      "additionalProperties": false,
      "required": ["$component"]
    },
    "combineTemplates": {
      "type": "array",
      "x-interface": "Combine Templates",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "array",
            "items": {
              "type": ["string", "null"]
            }
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "x-arrayAdd": false,
        "minItems": 2,
        "maxItems": 2
      },
      "tsType": "[(string | null)[], string][]"
    },
    "regExpFlags": {
      "type": "string",
      "default": "u",
      "pattern": "^[dgimsuvy]*$"
    }
  },
  "type": "object",
  "x-format": "nav-vertical-3",
  "x-interface": "Kadmos Dataset",
  "title": "Kadmos Dataset: {{ value.metadata.name }}",
  "x-objectAdd": false,
  "x-enablePropertiesToggle": true,
  "properties": {
    "metadata": {
      "type": "object",
      "x-interface": "Metadata",
      "title": "Metadata",
      "x-format": "grid",
      "properties": {
        "key": {
          "type": "string",
          "title": "Key",
          "description": "Unique key for this script dataset. Preferably from the <a href=\"https://www.iana.org/assignments/language-subtag-registry/language-subtag-registry\">IANA Language Subtag Registry</a>."
        },
        "name": {
          "type": "string",
          "title": "Name",
          "description": "Name of the dataset"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "x-grid": {
            "columns": 12
          },
          "x-format": "textarea"
        },
        "lang": {
          "type": "string",
          "title": "HTML lang attribute",
          "description": "cf. https://en.wikipedia.org/wiki/IETF_language_tag"
        },
        "dir": {
          "type": "string",
          "enum": ["ltr", "rtl"],
          "title": "Direction",
          "x-enumTitles": [
            "Left to right",
            "Right to left"
          ],
          "default": "ltr",
          "description": "Direction of the script: ltr for left-to-right (default) or rtl for right-to-left."
        },
        "gameHeading": {
          "type": "object",
          "title": "Game Heading",
          "x-interface": "Game Heading Config",
          "description": "Transliteration of 'Kadmos' using the dataset's script",
          "x-enableCollapseToggle": true,
          "oneOf": [
            {
              "properties": {
                "type": {"const": "string"},
                "string": {
                  "type": "string",
                  "default": "Kadmos"
                },
                "font": {
                  "$ref": "#/$defs/fontRef"
                }
              },
              "required": ["string"],
              "additionalProperties": false
            },
            {
              "properties": {
                "type": {"const": "custom"},
                "key": {"type": "string"},
                "data": {"type": "array"}
              },
              "additionalProperties": false,
              "required": ["type", "key"]
            }
          ]
        },
        "terms": {
          "type": "object",
          "title": "Terms",
          "x-interface": "Terms Config",
          "x-enableCollapseToggle": true,
          "description": "Specify what the equivalent of e.g. \"letter\" and \"letters\" in this font are called.",
          "properties": {
            "letter": {"type": "string", "default": "letter"},
            "letters": {"type": "string", "description": "Uses the term for letter + 's' by default."}
          },
          "additionalProperties": false
        }
      },
      "required": ["key", "name"],
      "additionalProperties": false
    },
    "letterConfig": {
      "title": "Letter Config",
      "x-interface": "Letter Config",
      "oneOf": [
        {
          "x-interface": "String Letter Config",
          "type": "object",
          "properties": {
            "type": {
              "const": "string"
            },
            "fonts": {
              "type": "object",
              "x-interface": "Fonts",
              "description": "A registry of the fonts used by the dataset, with lowercase keys.",
              "properties": {
                "data": {
                  "type": "object",
                  "x-titleTemplate": "{{ value.family }}",
                  "x-format": "pattern-nav",
                  "patternProperties": {
                    "^[a-z]+$": {
                      "title": "{{ value.family }}",
                      "x-interface": "Font Data",
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "Matches the font family by default."
                        },
                        "family": {
                          "type": "string",
                          "description": "Font family name. E.g. \"Noto Sans\" or \"Noto Serif Hebrew\".",
                          "default": "Noto Sans"
                        },
                        "default": {
                          "type": "boolean",
                          "title": "Use as default",
                          "default": false
                        },
                        "params": {
                          "$ref": "#/$defs/fontParams",
                          "x-grid": {"columns": 12},
                          "x-nColumns": 4
                        }
                      },
                      "required": ["family"],
                      "additionalProperties": false,
                      "x-format": "grid",
                      "x-nColumns": 3
                    }
                  },
                  "unevaluatedProperties": false
                },
                "params": {
                  "$ref": "#/$defs/fontParams",
                  "description": "Params applied to all fonts.",
                  "title": "Default params"
                },
                "manualUnicodes": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]+(-[0-9a-fA-F]+)?(,[0-9a-fA-F]+(-[0-9a-fA-F]+)?)*$",
                  "description": "List of unicode characters manually to be included."
                }
              },
              "required": ["data"],
              "additionalProperties": false
            }
          },
          "required": ["type", "fonts"],
          "x-switcherTitle": "Unicode",
          "additionalProperties": false
        },
        {
          "x-interface": "SVG Letter Config",
          "type": "object",
          "properties": {
            "type": {"const": "svg"},
            "template": {
              "oneOf": [
                {
                  "$ref": "#/$defs/component",
                  "title": "Component"
                },
                {
                  "x-interface": "SVG Template",
                  "type": "object",
                  "properties": {
                    "string": {
                      "type": "string",
                      "description": "Template string with $key$ for key substitutions"
                    },
                    "keys": {
                      "type": "array",
                      "items": {"type": "string"},
                      "description": "Keys in order used for the substitutions in the svg template."
                    }
                  },
                  "additionalProperties": false,
                  "required": ["string", "keys"]
                }
              ]
            }
          },
          "required": ["type", "template"],
          "x-switcherTitle": "SVG",
          "additionalProperties": false
        },
        {
          "x-interface": "Braille Letter Config",
          "type": "object",
          "properties": {
            "type": {"const": "braille"}
          },
          "required": ["type"],
          "x-switcherTitle": "Braille",
          "additionalProperties": false
        }
      ]
    },
    "languages": {
      "type": "object",
      "title": "Languages",
      "x-interface": "Languages",
      "description": "List of languages that you can play the game in.",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "title": "Key"
          },
          "uniqueItems": true,
          "description": "Language subtags. In items, use \"p:PROPERTY_SUBTAG\" (e.g. \"p:name_de\") as key to specify language-specific property values."
        },
        "default": {"type": "string"}
      },
      "required": ["keys"],
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "title": "Variants",
      "x-interface": "Variants Config",
      "properties": {
        "data": {
          "type": "object",
          "x-format": "pattern-nav",
          "patternProperties": {
            "^[a-z]+$": {
              "type": "object",
              "x-interface": "Variant Data",
              "description": "A variant of the script, e.g. the Russian or Bulgarian variant of the Cyrillic script.",
              "properties": {
                "label": {"type": "string"},
                "lang": {
                  "type": "string",
                  "description": "Modifying the HTML lang attribute of the symbols. By default, the key pointing to this entry is used."
                },
                "default": {
                  "type": "boolean",
                  "default": false
                },
                "fontParams": {
                  "type": "object",
                  "description": "Modifying the dataset's fonts entries.",
                  "x-format": "pattern-nav",
                  "patternProperties": {
                    "^[a-z]+$": {"$ref": "#/$defs/fontParams"}
                  }
                }
              },
              "additionalProperties": false,
              "required": ["label"]
            }
          }
        },
        "groups": {
          "type": "object",
          "x-format": "pattern-nav",
          "patternProperties": {
            "^[a-z]+$": {
              "type": "object",
              "properties": {
                "label": {"type":  "string"},
                "keys": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "List of keys from the variants.data field."
                }
              },
              "required": ["label", "keys"]
            }
          }
        },
        "setting": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["select", "buttonGroup"],
              "default": "select",
              "x-enumTitles": ["Selectbox", "Button Group"]
            },
            "label": {
              "type": "string",
              "default": "Variant"
            }
          }
        },
        "useKeyAsLang": {
          "type": "boolean",
          "description": "If true, the lang attribute of a variant will be set to its key unless already specified.",
          "default": false
        },
        "default": {
          "type": "string",
          "title": "Default variant key"
        }
      },
      "required": ["data"],
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "x-interface": "Game Config",
      "title": "Game",
      "properties": {
        "defaultWeight": {"$ref": "#/$defs/fontWeight"}
      }
    },
    "subsets": {
      "type": "object",
      "title": "Subsets",
      "x-interface": "Subsets",
      "x-format": "pattern-nav",
      "patternProperties": {
        "^[a-z]+$": {
          "x-interface": "Subset",
          "title": "Subset",
          "type": "object",
          "x-format": "categories-vertical",
          "properties": {
            "label": {
              "type": "string",
              "title": "Label",
              "default": "Letters"
            },
            "properties": {
              "title": "Properties",
              "x-interface": "Subset Properties",
              "type": "object",
              "x-category": "Properties",
              "x-format": "pattern-nav",
              "patternProperties": {
                "^[a-z]+$": {
                  "x-interface": "Subset Property Params",
                  "type": "object",
                  "properties": {
                    "label": {"type": "string"},
                    "config": {
                      "$ref": "#/$defs/quizAnswerConfig"
                    },
                    "active": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": ["label", "config"],
                  "additionalProperties": false
                }
              },
              "unevaluatedProperties": false
            },
            "selector": {
              "type": "object",
              "title": "Selector",
              "x-interface": "Selector Config",
              "x-category": "Selector",
              "properties": {
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/selectorBlock",
                    "properties": {
                      "letters": {"$ref": "#/$defs/letterRanges"}
                    },
                    "unevaluatedProperties": false,
                    "x-objectAdd": false
                  }
                },
                "font": {"$ref": "#/$defs/fontRef"},
                "label": {
                  "type": "object",
                  "description": "Settings for the label underneath letters in the selector. If not set, these won't appear.",
                  "properties": {
                    "property": {
                      "type": "string",
                      "description": "Which property to label the items with."
                    },
                    "splitFirst": {
                      "type": "boolean",
                      "description": "If true, only shows the first value of a list property.",
                      "default": true
                    }
                  },
                  "required": ["property"]
                },
                "style": {"$ref": "#/$defs/blockStyle"},
                "defaultActive": {
                  "type": "string",
                  "pattern": "^(all|none|block\\d+)$",
                  "default": "all",
                  "description": "'all', 'none' or 'block{INDEX}'."
                }
              },
              "additionalProperties": false
            },
            "forms": {
              "type": "object",
              "title": "Forms",
              "x-interface": "Forms Config",
              "x-category": "Forms",
              "properties": {
                "data": {
                  "type": "object",
                  "description": "A form of letter, e.g. lower- or uppercase.",
                  "x-format": "pattern-nav",
                  "patternProperties": {
                    "^[a-z]+$": {
                      "type": "object",
                      "x-interface": "Form Config",
                      "properties": {
                        "combine": {
                          "type": "array",
                          "items": {"type": "string"},
                          "x-editJsonData": true
                        },
                        "label": {"type": "string"},
                        "active": {
                          "type": "boolean",
                          "title": "Active",
                          "default": true
                        },
                        "groupWith": {
                          "type": "string",
                          "title": "Group With Key",
                          "description": "If set, this form will not appear in the settings, but will follow the setting of the given key."
                        }
                      },
                      "required": ["label"],
                      "unevaluatedProperties": false,
                      "x-objectAdd": false
                    }
                  }
                },
                "label": {
                  "type": "string",
                  "description": "Label of the forms setting. Default \"Forms\".",
                  "default": "Forms"
                },
                "exclusive": {
                  "type": "boolean",
                  "description": "If true, you can only select one form to play at a time.",
                  "default": false
